    "@tauri-apps/plugin-updater": "^2.10.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "playwright": "^1.62.0",
    "sass": "^1.100.0",
