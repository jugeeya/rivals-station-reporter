{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivals Station Reporter",
  "version": "../package.json",
  "identifier": "io.github.jugeeya.rivals-station-reporter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rivals Station Reporter",
        "width": 980,
        "height": 760,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "jugeeya",
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwOTdCQjYwRUYzQjE0QTEKUldTaEZEdnZZTHVYY0MvVTNITXFQWlVTRGhXeGVydWIyTWM1a2Q0YWFzQ3BueEhscWlKU2tkSHgK",
      "endpoints": [
        "https://github.com/jugeeya/rivals-station-reporter/releases/latest/download/latest.json"
      ]
    }
  }
}
